# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env никому не показывайте.
# Ключ: developers.sber.ru -> проект GigaChat API -> Authorization Key
GIGACHAT_AUTH_KEY=вставьте_ключ_сюда

# Необязательно:
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# PORT=3000

# Если Node ругается на сертификат Сбера, а сертификат Минцифры ещё не подключён,
# для быстрого теста на своём компьютере можно включить (в рабочем режиме не нужно):
# GIGACHAT_INSECURE=1
